# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=medical_cell_test

# JWT
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_REFRESH_EXPIRATION=10d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS S3
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=medical-cell-test-bucket

# Mail (AWS SES)
MAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USER=your-ses-smtp-username
MAIL_PASSWORD=your-ses-smtp-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Medical Cell Test

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_FREE_EXAM_PRICE_ID=price_free_exam
STRIPE_PAID_EXAM_PRICE_ID=price_paid_exam
STRIPE_GROUP_EXAM_PRICE_ID=price_group_exam

# OTP
OTP_EXPIRATION=10m
OTP_MAX_ATTEMPTS=10
OTP_LOCKOUT_DURATION=5m
OTP_RESEND_INTERVAL=60s

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Session
SESSION_TAKER_EXPIRATION=10d
SESSION_ADMIN_EXPIRATION=1h
SESSION_COOKIE_SECRET=your-session-cookie-secret
